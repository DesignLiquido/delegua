// Exemplo de funções em Prisma

// Função simples
funcao saudacao(nome) {
    retorna "Olá, " + nome + "!";
}

// Função com parâmetros padrão
funcao calcularArea(largura, altura = 1) {
    retorna largura * altura;
}

// Função recursiva - fibonacci
funcao fibonacci(n) {
    se (n <= 1) {
        retorna n;
    } senão {
        retorna fibonacci(n - 1) + fibonacci(n - 2);
    }
}

// Testando as funções
local mensagem = saudacao("Maria");
imprima(mensagem);

local area1 = calcularArea(5, 3);
local area2 = calcularArea(4); // usa altura padrão
imprima("Área 1:", area1);
imprima("Área 2:", area2);

imprima("Fibonacci de 6:", fibonacci(6));

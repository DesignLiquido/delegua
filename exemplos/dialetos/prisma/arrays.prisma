// Exemplo de trabalho com arrays/vetores em Prisma

// Criando arrays
local frutas = ["maçã", "banana", "laranja"];
local numeros = [1, 2, 3, 4, 5];
local misto = [1, "texto", verdadeiro, 3.14];

// Acessando elementos
imprima("Primeira fruta:", frutas[0]);
imprima("Segundo número:", numeros[1]);

// Modificando elementos
frutas[0] = "pêra";
imprima("Nova primeira fruta:", frutas[0]);

// Trabalhando com métodos de array
imprima("Tamanho do array frutas:", tamanho(frutas));

// Adicionando elementos
frutas[3] = "uva";
imprima("Array após adição:", frutas);

// Iterando sobre array
imprima("Todas as frutas:");
para cada fruta em frutas {
    imprima("-", fruta);
}

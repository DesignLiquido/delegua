// Exemplo de estruturas de repetição em Prisma

// Loop for tradicional
imprima("Loop for tradicional:");
para i = 1, 5 inicio
    imprima("Contador:", i);
fim

// Loop while
imprima("Loop while:");
local contador = 1;
enquanto contador <= 3 inicio
    imprima("While contador:", contador);
    contador = contador + 1;
fim

// Loop com array
imprima("Loop para cada:");
local numeros = {1, 2, 3, 4, 5};
para cada numero em numeros inicio
    imprima("Número:", numero);
fim

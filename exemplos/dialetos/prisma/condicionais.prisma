// Exemplo de estruturas condicionais em Prisma
var idade = 18;

se (idade >= 18) {
    escreva("Maior de idade");
} senão {
    escreva("Menor de idade");
}

var nota = 7.5;

se (nota >= 9) {
    escreva("Excelente");
} senão se (nota >= 7) {
    escreva("Bom");
} senão se (nota >= 5) {
    escreva("Regular");
} senão {
    escreva("Insuficiente");
}

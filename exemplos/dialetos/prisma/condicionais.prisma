// Exemplo de estruturas condicionais em Prisma
local idade = 18;

se idade >= 18 entao
    imprima("Maior de idade");
senao
    imprima("Menor de idade");
fim

local nota = 7.5;

se nota >= 9 entao
    imprima("Excelente");
senao se nota >= 7 entao
    imprima("Bom");
senao se nota >= 5 entao
    imprima("Regular");
senao
    imprima("Insuficiente");
fim

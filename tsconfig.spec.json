{
    "compilerOptions": {
        "outDir": "dist",
        "module": "CommonJS",
        "target": "es2017",
        "allowJs": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "types": ["node", "jest"]
    },
    "include": [
        "fontes/**/*",
        "testes/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
